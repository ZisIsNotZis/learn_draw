+"""Proposed independent depth-sample regression; do not apply without parent review."""
+import math
+import unittest
+
+import numpy as np
+
+from scripts.tests.test_vector_visibility import ring_and_occluder
+from vector_visibility import EPS, line_clip, visible_fragments
+
+
+def _barycentric(triangle, x, y):
+    (x0, y0, _), (x1, y1, _), (x2, y2, _) = triangle
+    det = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0)
+    wb = ((x - x0) * (y2 - y0) - (y - y0) * (x2 - x0)) / det
+    wc = ((x1 - x0) * (y - y0) - (y1 - y0) * (x - x0)) / det
+    return 1 - wb - wc, wb, wc
+
+
+def _depth_oracle(faces, n):
+    strips = [tri for tri, _color, component in faces if component == "strip"]
+    xmin = min(p[0] for tri in strips for p in tri)
+    ymin = min(p[1] for tri in strips for p in tri)
+    xmax = max(p[0] for tri in strips for p in tri)
+    ymax = max(p[1] for tri in strips for p in tri)
+    xs = xmin + (np.arange(n) + .5) * ((xmax - xmin) / n)
+    ys = ymin + (np.arange(n) + .5) * ((ymax - ymin) / n)
+    strip_z = np.full((n, n), -np.inf)
+    body_z = np.full((n, n), -np.inf)
+    source_edge = np.zeros((n, n), dtype=bool)
+    for triangle, _color, component in faces:
+        tri = np.asarray(triangle, dtype=float)
+        ix0 = int(np.searchsorted(xs, tri[:, 0].min(), side="left"))
+        ix1 = int(np.searchsorted(xs, tri[:, 0].max(), side="right"))
+        iy0 = int(np.searchsorted(ys, tri[:, 1].min(), side="left"))
+        iy1 = int(np.searchsorted(ys, tri[:, 1].max(), side="right"))
+        if ix0 >= ix1 or iy0 >= iy1:
+            continue
+        region = np.s_[iy0:iy1, ix0:ix1]
+        xx, yy = np.meshgrid(xs[ix0:ix1], ys[iy0:iy1])
+        (x0, y0, z0), (x1, y1, z1), (x2, y2, z2) = tri
+        det = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0)
+        wb = ((xx - x0) * (y2 - y0) - (yy - y0) * (x2 - x0)) / det
+        wc = ((x1 - x0) * (yy - y0) - (y1 - y0) * (xx - x0)) / det
+        wa = 1 - wb - wc
+        inside = (wa >= -1e-12) & (wb >= -1e-12) & (wc >= -1e-12)
+        source_edge[region] |= inside & (np.minimum.reduce(
+            (np.abs(wa), np.abs(wb), np.abs(wc))) <= 1e-10)
+        target = strip_z[region] if component == "strip" else body_z[region]
+        np.maximum(target, wa * z0 + wb * z1 + wc * z2, out=target, where=inside)
+    strip_covered, body_covered = np.isfinite(strip_z), np.isfinite(body_z)
+    depth_tie = strip_covered & body_covered & (np.abs(strip_z - body_z) <= 1e-10)
+    visible_strip = strip_covered & (~body_covered | (strip_z > body_z + 1e-10))
+    return xs, ys, visible_strip, source_edge | depth_tie
+
+
+def _inside_or_sampled_boundary(poly, xx, yy):
+    inside = np.zeros(xx.shape, dtype=bool)
+    boundary = np.zeros(xx.shape, dtype=bool)
+    for a, b in zip(poly, poly[1:] + poly[:1]):
+        ax, ay = a[:2]
+        bx, by = b[:2]
+        dx, dy = bx - ax, by - ay
+        length2 = dx * dx + dy * dy
+        if length2 == 0:
+            continue
+        cross = (xx - ax) * dy - (yy - ay) * dx
+        dot = (xx - ax) * dx + (yy - ay) * dy
+        boundary |= ((np.abs(cross) <= 1e-12 * max(1, math.sqrt(length2)))
+                     & (dot >= -1e-12) & (dot <= length2 + 1e-12))
+        if ay != by:
+            crossing = (ay > yy) != (by > yy)
+            inside ^= crossing & (xx < ax + (yy - ay) * dx / dy)
+    return inside | boundary
+
+
+class OriginalTriangleDepthOracleTests(unittest.TestCase):
+    def test_visible_source_sample_centres_are_in_fragment_union(self):
+        # One-sided sampled coverage only; the summed-area compatibility alarm remains separate.
+        for yaw in (0, 55):
+            faces = [([(x - 200, y - 150, z) for x, y, z in triangle], color, component)
+                     for triangle, color, component in ring_and_occluder(yaw)]
+            for n in (256, 512):
+                with self.subTest(yaw=yaw, n=n):
+                    xs, ys, truth, ambiguous = _depth_oracle(faces, n)
+                    covered = np.zeros(truth.shape, dtype=bool)
+                    for poly, _color, component in visible_fragments(faces):
+                        if component != "strip" or len(poly) < 3:
+                            continue
+                        if abs(sum(a[0] * b[1] - b[0] * a[1]
+                                   for a, b in zip(poly, poly[1:] + poly[:1]))) <= 2e-18:
+                            continue
+                        tri = np.asarray(poly)
+                        ix0 = int(np.searchsorted(xs, tri[:, 0].min(), side="left"))
+                        ix1 = int(np.searchsorted(xs, tri[:, 0].max(), side="right"))
+                        iy0 = int(np.searchsorted(ys, tri[:, 1].min(), side="left"))
+                        iy1 = int(np.searchsorted(ys, tri[:, 1].max(), side="right"))
+                        if ix0 >= ix1 or iy0 >= iy1:
+                            continue
+                        xx, yy = np.meshgrid(xs[ix0:ix1], ys[iy0:iy1])
+                        covered[iy0:iy1, ix0:ix1] |= _inside_or_sampled_boundary(poly, xx, yy)
+                    self.assertFalse(np.any(truth & ~ambiguous & ~covered))
+
+    def test_eps_shifted_line_clip_intersections_remain_in_source_triangle(self):
+        source = [(-.8, 0, 0), (-1.2, 1, 0), (-.8, 2, 0)]
+        clipped = line_clip(source, lambda p: EPS * p[0], keep_positive=True)
+        for point in clipped:
+            self.assertTrue(all(math.isfinite(value) for value in point))
+            self.assertGreaterEqual(min(_barycentric(source, point[0], point[1])), -1e-12)
+        # This kept halfspace has boundary fn == -EPS, not fn == 0.
+        self.assertTrue(all(abs(point[0] + 1) <= 1e-12
+                            for point in clipped if point not in source))
+
