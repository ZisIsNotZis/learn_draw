      "length": 0.5,
      "thickness": 0.065,
      "angle": -8,
      "bend": 0.03,
      "ink_width": 0.003,
      "depth": 2,
      "palette": {
        "fill": "#cf8c70",
        "ink": "#493b40"
      },
      "attachment": {
        "to": "blouse",
        "self": "root",
        "target": "left@.93",
