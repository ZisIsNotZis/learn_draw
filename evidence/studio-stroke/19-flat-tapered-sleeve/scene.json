{
  "format": "learn-draw/studio-1",
  "canvas": [
    800,
    800
  ],
  "background": "#f6ecdf",
  "nodes": [
    {
      "id": "friend",
      "kind": "head",
      "intent": "the smiling face in a small original greeting portrait",
      "length": 0.3,
      "expression": "smile",
      "angle": -4,
      "depth": 10,
      "at": {
        "anchor": "center",
        "offset": [
          -0.12,
          -0.2
        ]
      }
    },
    {
      "id": "neck",
      "kind": "stroke",
      "intent": "a short neck joins the chin and blouse",
      "length": 0.035,
      "thickness": 0.04,
      "depth": 5,
      "palette": {
        "fill": "#dfb39c",
        "ink": "#493b40"
      },
      "ink_width": 0.003,
